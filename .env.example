# HCC 2.0 — Environment-Vorlage OHNE Secrets.
# Produktionswerte gehören nach /etc/hcc/hcc.env (0640, root:hcc) bzw.
# /etc/hcc/secrets.env (0640, nur Service-Gruppe). Nie ins Repository committen.

# --- Allgemein ---------------------------------------------------------------
HCC_ENVIRONMENT=development            # development | staging | production
HCC_HOST=127.0.0.1                     # Backend bindet nur auf Loopback; nginx leitet weiter
HCC_PORT=8000
HCC_LOG_LEVEL=INFO
HCC_GIT_COMMIT=unknown                 # optional: Build/Commit-Referenz für /api/v1/version

# --- Datenbank ---------------------------------------------------------------
# Produktion: PostgreSQL (dedizierter User, kein Superuser)
# Entwicklung/Test: sqlite:///./dev.sqlite3
HCC_DATABASE_URL=postgresql+psycopg://hcc:hcc@127.0.0.1:5432/hcc

# --- Sessions / Cookies ------------------------------------------------------
HCC_SESSION_TTL_SECONDS=43200          # 12 h absolute Lifetime
HCC_COOKIE_SECURE=false                # MUSS in production true sein (Fail-Fast in Settings)
HCC_SESSION_COOKIE_NAME=hcc_session
HCC_CSRF_COOKIE_NAME=hcc_csrf

# --- Admin-Bootstrap (einmalig) ----------------------------------------------
# Wird nur benötigt, solange keine User existieren. Danach wird /auth/bootstrap
# dauerhaft abgelehnt. Wert: zufälliges, langes Secret (z. B. 48+ Zeichen).
# LEER lassen in Commits/Demos.
HCC_BOOTSTRAP_TOKEN=

# --- CORS (restriktiv) ---------------------------------------------------------
# Leer = nur same-origin. Bei Bedarf explizit: https://hcc.tail100.example
HCC_CORS_ORIGINS=
